/* Estilo de ombu para las apps Qt que usan qt6ct (hoy, Dolphin), con el lenguaje de los menús de ombu
   y de Finder: la barra lateral es una tarjeta flotante, la fila elegida va en gris (no en acento) y el
   acento queda para lo activo (la acción principal, una casilla marcada, el foco de un campo).
   Medidas de Theme.qml: controles de radio 10, filas de 32 px, filas de menú de radio 7. */

/* Barra lateral de lugares: tarjeta como el sidebar de Finder. KDE pinta sus filas sin pasarle el widget
   al estilo, así que las reglas ::item no le llegan (ni radio ni márgenes): solo toma los colores de
   selection-*; el padding de la tarjeta es lo que separa las filas del borde */
KFilePlacesView, QListView#placesView {
    background: #1d1c26;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    margin: 2px 4px 10px 10px;
    padding: 6px 6px;
    min-width: 210px;
    selection-background-color: #2b2a38;
    selection-color: #e8e8f0;
}
KFilePlacesView > QWidget {
    background: transparent;
}
KFilePlacesView::item {
    padding: 6px 8px;
    margin: 0px 6px;
    border-radius: 8px;
    border: none;
}
KFilePlacesView::item:hover {
    background: rgba(255, 255, 255, 0.06);
}
KFilePlacesView::item:selected {
    background: #2b2a38;
    color: #e8e8f0;
}

/* Barra de herramientas: ← →, la ruta, la vista, buscar y el menú */
QToolBar {
    background: #14131a;
    border: none;
    padding: 6px 10px;
    spacing: 4px;
}
QToolBar::separator {
    background: rgba(255, 255, 255, 0.08);
    width: 1px;
    margin: 6px 4px;
}
QToolButton {
    background: transparent;
    border: none;
    border-radius: 10px;
    padding: 6px;
}
QToolButton:hover {
    background: rgba(255, 255, 255, 0.09);
}
QToolButton:pressed, QToolButton:checked {
    background: #2b2a38;
}
/* Sin la flechita de menú en cada botón: el clic sostenido igual abre el historial */
QToolButton::menu-indicator {
    image: none;
    width: 0px;
}
QToolButton[popupMode="1"] {
    padding-right: 16px;
}
QToolButton::menu-button {
    border: none;
    background: transparent;
    width: 14px;
}
KUrlNavigator {
    background: transparent;
}

/* Campos de texto y ruta */
QLineEdit {
    background: #1d1c26;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 5px 10px;
    selection-background-color: #a78bfa;
    selection-color: #14131a;
}
QLineEdit:focus {
    border: 1px solid #a78bfa;
}

/* Pestañas */
QTabBar::tab {
    background: transparent;
    border: none;
    border-radius: 9px;
    padding: 5px 14px;
    margin: 4px 2px;
    color: #8a8a9c;
}
QTabBar::tab:hover {
    background: rgba(255, 255, 255, 0.06);
    color: #e8e8f0;
}
QTabBar::tab:selected {
    background: #1d1c26;
    color: #e8e8f0;
}
QTabWidget::pane {
    border: none;
}

/* Menús contextuales: como los de ombu, fondo sólido, filo fino y filas grises. El radio necesita un
   estilo que haga los menús translúcidos (Darkly): con Fusion las esquinas quedan negras */
QMenu {
    background: #14131a;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    padding: 6px;
}
QMenu::item {
    background: transparent;
    border-radius: 7px;
    padding: 6px 28px 6px 10px;
    margin: 0px;
}
QMenu::item:selected {
    background: #1d1c26;
    color: #e8e8f0;
}
QMenu::item:disabled {
    color: #8a8a9c;
}
QMenu::icon {
    padding-left: 8px;
}
QMenu::separator {
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
    margin: 5px 8px;
}
QMenu::right-arrow {
    width: 10px;
    height: 10px;
    margin-right: 6px;
}

QToolTip {
    background: #1d1c26;
    color: #e8e8f0;
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 5px 8px;
}

/* Barras de desplazamiento finas */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.16);
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.28);
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.16);
    border-radius: 3px;
    min-width: 30px;
}
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    border: none;
    width: 0;
    height: 0;
}

/* Separadores sutiles */
QSplitter::handle, QMainWindow::separator {
    background: transparent;
    width: 4px;
    height: 4px;
}
QStatusBar {
    background: #14131a;
    border: none;
    color: #8a8a9c;
}

/* Botones: neutros; la acción principal del diálogo lleva el acento */
QPushButton {
    background: #2b2a38;
    border: none;
    border-radius: 10px;
    padding: 7px 16px;
}
QPushButton:hover {
    background: #3a3950;
}
QPushButton:pressed, QPushButton:checked {
    background: #323146;
}
QPushButton:default {
    background: #a78bfa;
    color: #14131a;
}
QPushButton:disabled {
    color: #8a8a9c;
}

/* Selectores, sliders y barras de progreso */
QComboBox {
    background: #2b2a38;
    border: none;
    border-radius: 10px;
    padding: 5px 10px;
}
QComboBox:hover {
    background: #3a3950;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background: #14131a;
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 4px;
    outline: none;
    selection-background-color: #1d1c26;
    selection-color: #e8e8f0;
}
QSlider::groove:horizontal {
    background: #2b2a38;
    height: 4px;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: rgba(255, 255, 255, 0.35);
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #e8e8f0;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QProgressBar {
    background: #2b2a38;
    border: none;
    border-radius: 4px;
    text-align: center;
}
QProgressBar::chunk {
    background: #a78bfa;
    border-radius: 4px;
}

/* Casillas y botones de opción */
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: #1d1c26;
}
QCheckBox::indicator {
    border-radius: 5px;
}
QRadioButton::indicator {
    border-radius: 9px;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #a78bfa;
    border-color: #a78bfa;
}
